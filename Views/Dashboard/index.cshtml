@model dynamic

@{
    ViewData["Title"] = "Safety Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">Inspection Dashboard</h1>
        <div class="badge bg-info p-2 fs-6 shadow-sm">User: @User.Identity?.Name</div>
    </div>

    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Town</label>
                    <select name="town" class="form-select" onchange="this.form.submit()">
                        <option value="All">All Locations</option>
                        @foreach (var t in Model.Towns) {
                            <option value="@t" selected="@(ViewBag.SelectedTown == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold">Risk Level</label>
                    <select name="riskRating" class="form-select" onchange="this.form.submit()">
                        @foreach (var r in Model.RiskRatings) {
                            <option value="@r" selected="@(ViewBag.SelectedRiskRating == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear All</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card text-white bg-dark h-100 shadow">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Total Premises</h6>
                    <p class="display-4 fw-bold mb-0">@Model.TotalPremises</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary h-100 shadow">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Inspections (Month)</h6>
                    <p class="display-4 fw-bold mb-0">@Model.InspectionsThisMonth</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger h-100 shadow">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Failed (Month)</h6>
                    <p class="display-4 fw-bold mb-0">@Model.FailedInspectionsThisMonth</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-dark bg-warning h-100 shadow">
                <div class="card-body text-center">
                    <h6 class="text-uppercase opacity-75">Overdue Follow-ups</h6>
                    <p class="display-4 fw-bold mb-0">@Model.OverdueFollowUps</p>
                </div>
            </div>
        </div>
    </div>
</div>