@model oop_s2_2_mvc_78853.Models.Premises

@{
    ViewData["Title"] = "Create Premises";
}

<h1>Create New Premises</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label font-weight-bold"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Dublin Diner" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label font-weight-bold"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Town" class="control-label font-weight-bold"></label>
                <input asp-for="Town" class="form-control" />
                <span asp-validation-for="Town" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RiskRating" class="control-label font-weight-bold"></label>
                <select asp-for="RiskRating" class="form-control">
                    <option value="">-- Select Risk Rating --</option>
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                </select>
                <span asp-validation-for="RiskRating" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Save Premises" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}