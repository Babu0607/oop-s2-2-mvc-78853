@model oop_s2_2_mvc_78853.Models.Premises

@{
    ViewData["Title"] = "Premises Details";
}

<h1>Premises Details</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">Town</dt>
            <dd class="col-sm-9">@Model.Town</dd>

            <dt class="col-sm-3">Risk Rating</dt>
            <dd class="col-sm-9">
                @if (Model.RiskRating == "High")
                {
                    <span class="badge bg-danger">High</span>
                }
                else if (Model.RiskRating == "Medium")
                {
                    <span class="badge bg-warning">Medium</span>
                }
                else
                {
                    <span class="badge bg-success">Low</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back List</a>
    </div>
</div>
